#!/bin/bash -e

# amq soliluna check — full local CI check for soliluna.
#
# Mirrors .github/workflows/ci-soliluna.yml so a green CI run and a local
# `amq soliluna check` cannot diverge:
#   install deps (pnpm) + typecheck (pnpm -r typecheck) + tests unitarios.
#
# Runtime: pnpm workspaces (Node 24; la API se ejecuta sin compilar, y el type
# stripping de Node hace falta para eso). Install uses --frozen-lockfile (like CI) and
# is skipped when node_modules is already present so repeated local runs stay
# fast; CI has no node_modules and installs fresh.

if [ ! -d node_modules ]; then
  echo "==> pnpm install --frozen-lockfile"
  pnpm install --frozen-lockfile
else
  echo "==> deps present, skipping pnpm install"
fi

echo "==> typecheck (pnpm -r typecheck)"
pnpm -r typecheck

echo "==> tests unitarios (pnpm test:unit)"
pnpm test:unit
