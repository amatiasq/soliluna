#!/bin/bash -e

# amq soliluna secrets — escribe el `.env` del stack de soliluna en el VPS.
#
# Son dos variables, y el compose no arranca bien sin ninguna de las dos:
#   SOLILUNA_AUTH   "usuario:pass,usuario2:pass2" — sin esto la app da 503 a todo
#   SOLILUNA_HOST   el dominio que sirve este stack
#
# El `.env` del servidor es hoy la única copia de este secreto fuera de
# 1Password: no se sube con rsync (`amq vps deploy` lo excluye) y no está en el
# repo. Ver ../../infra/.agents/plans/secretos-en-1password.md.
#
# Config (env):
#   SOLILUNA_SERVICE   carpeta del stack en el VPS (default: soliluna)
#   SOLILUNA_OP_ITEM   item de 1Password con un campo SOLILUNA_AUTH (obligatorio)
#
# El host se deriva de la carpeta: `soliluna` → soliluna.amatiasq.com,
# `soliluna-v3` → soliluna-v3.amatiasq.com. Es la misma regla que usa el DNS.

SERVICE="${SOLILUNA_SERVICE:-soliluna}"
HOST="$SERVICE.amatiasq.com"
DEST="~/vps/docker/$SERVICE/.env"

if [[ -z "$SOLILUNA_OP_ITEM" ]]; then
  echo "Falta SOLILUNA_OP_ITEM: el item de 1Password con el campo SOLILUNA_AUTH." >&2
  echo "" >&2
  echo "soliluna no tenía item propio: sus credenciales vivían como secreto de" >&2
  echo "Cloudflare, y hay que rotarlas porque se expusieron. Crea el item con un" >&2
  echo "campo SOLILUNA_AUTH = 'usuario:pass,usuario2:pass2' y pasa su id aquí." >&2
  exit 1
fi

AUTH="$(amq op item get "$SOLILUNA_OP_ITEM" --fields label=SOLILUNA_AUTH | jq -r '.value')"

if [[ -z "$AUTH" || "$AUTH" == "null" ]]; then
  echo "El item $SOLILUNA_OP_ITEM no tiene un campo SOLILUNA_AUTH con valor." >&2
  exit 1
fi

echo "==> escribiendo $DEST (host: $HOST)"
{
  echo "SOLILUNA_HOST=$HOST"
  echo "SOLILUNA_AUTH=$AUTH"
} | amq vps ssh "mkdir -p ~/vps/docker/$SERVICE && cat > $DEST && chmod 600 $DEST"

echo "==> listo. Comprueba con: amq vps ssh 'ls -l $DEST'"
