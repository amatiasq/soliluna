#!/bin/bash -e

# amq soliluna secrets — escribe el `.env` del stack de soliluna en el VPS.
#
# 1Password es la fuente de verdad y el `.env` del servidor un derivado: `amq
# soliluna deploy` llama a esto antes de levantar el stack, así que borrarlo a
# mano no rompe nada. Los valores los compone `amq soliluna dotenv`.
#
# En una variable y no encañonado: `amq soliluna dotenv | amq vps dotenv` no
# vería fallar a 1Password, y una sesión caducada dejaría el `.env` vacío — que
# en soliluna es un 503 en toda la app.
#
# Config (env):
#   SOLILUNA_SERVICE   carpeta del stack en el VPS (default: soliluna)

SERVICE="${SOLILUNA_SERVICE:-soliluna}"

DOTENV="$(amq soliluna dotenv)"

printf '%s\n' "$DOTENV" | amq vps dotenv "$SERVICE"
