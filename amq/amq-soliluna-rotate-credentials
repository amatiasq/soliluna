#!/bin/bash -e

# amq soliluna rotate-credentials — contraseñas nuevas y al servidor.
#
# Genera una contraseña nueva para cada usuario en 1Password y reescribe el
# `.env` del VPS. El contenedor sigue con las viejas hasta que se reinicia:
# `amq soliluna deploy`.
#
# Sin símbolos: SOLILUNA_AUTH es "usuario:pass,usuario2:pass2" en crudo, así que
# una coma parte el par y deja al usuario fuera sin decir nada. 32 caracteres
# alfanuméricos son de sobra.
RECIPE='letters,digits,32'

# amatiasq
amq op item edit "zxiv446rm7rwvt3qw2bmuv3dya" --generate-password="$RECIPE"

# mika
amq op item edit "doss62czmn5mowto44g2mrdoiy" --generate-password="$RECIPE"

amq soliluna secrets
