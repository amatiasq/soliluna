#!/bin/bash -e

# Ship soliluna infra (compose + nginx.conf) to the VPS and restart.
# soliluna is a static nginx site — no image to build; deploy just syncs the
# reverse-proxy config and recreates the container.
#
# Run via `amq soliluna deploy`.

SERVICE="soliluna"

echo "==> ship infra (compose + nginx) to VPS"
amq deploy-infra "$SERVICE"

echo "==> pull-and-restart on VPS"
amq vps pull-and-restart "$SERVICE"
